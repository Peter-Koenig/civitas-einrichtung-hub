    COALESCE(v.grabstaette_status, g.grabstaette_status) AS grabstaette_status,
    COALESCE(v.bestattungsart, g.bestattungsart) AS bestattungsart,
    COALESCE(v.kommune_id, g.kommune_id) AS kommune_id,
    COALESCE(v.version_nr, 0) AS version_nr,
    v.osm_id,
    v.osm_version,
    v.osm_changeset_id,
    v.osm_raw_data AS osm_rohdaten,
    v.osm_merge_note,
    v.edit_comment AS osm_edit_comment,
    v.session_id AS aktuelle_session_id,
