-- p2d2 DDL-Template (Basisschema p2d2_develop).
-- Schema-parametrisiert: {{ p2d2_instance_schema }} / {{ p2d2_admin_role }}.
-- Nur Struktur, keine Daten. Lesend aus der Standalone-DB data-dna extrahiert (P2D2-RO).
-- Bewusst ausgeschlossen: gt_pk_metadata, rheinkassel_gf (+ zugehoerige Sequenz).


DO $$
BEGIN
    IF NOT EXISTS (
        SELECT 1 FROM pg_type t
        JOIN pg_namespace n ON n.oid = t.typnamespace
        WHERE t.typname = 'wf_event_type' AND n.nspname = '{{ p2d2_instance_schema }}'
    ) THEN
        CREATE TYPE {{ p2d2_instance_schema }}.wf_event_type AS ENUM (
    'session_start',
    'session_pause',
    'session_resume',
    'session_end',
    'session_expire',
    'session_abort',
    'feature_edit',
    'feature_save',
    'snapshot_create',
    'qs1_pass',
    'qs1_fail',
    'qs2_pass',
    'qs2_fail',
    'export_osm'
);
    END IF;
END$$;


ALTER TYPE {{ p2d2_instance_schema }}.wf_event_type OWNER TO "{{ p2d2_admin_role }}";

DO $$
BEGIN
    IF NOT EXISTS (
        SELECT 1 FROM pg_type t
        JOIN pg_namespace n ON n.oid = t.typnamespace
        WHERE t.typname = 'wf_feature_state' AND n.nspname = '{{ p2d2_instance_schema }}'
    ) THEN
        CREATE TYPE {{ p2d2_instance_schema }}.wf_feature_state AS ENUM (
    'unbearbeitet',
    'in_bearbeitung',
    'qs1_ausstehend',
    'qs1_abgelehnt',
    'qs2_ausstehend',
    'qs2_abgelehnt',
    'exportbereit',
    'exportiert'
);
    END IF;
END$$;


ALTER TYPE {{ p2d2_instance_schema }}.wf_feature_state OWNER TO "{{ p2d2_admin_role }}";

DO $$
BEGIN
    IF NOT EXISTS (
        SELECT 1 FROM pg_type t
        JOIN pg_namespace n ON n.oid = t.typnamespace
        WHERE t.typname = 'wf_qs_level' AND n.nspname = '{{ p2d2_instance_schema }}'
    ) THEN
        CREATE TYPE {{ p2d2_instance_schema }}.wf_qs_level AS ENUM (
    'qs1',
    'qs2'
);
    END IF;
END$$;


ALTER TYPE {{ p2d2_instance_schema }}.wf_qs_level OWNER TO "{{ p2d2_admin_role }}";

DO $$
BEGIN
    IF NOT EXISTS (
        SELECT 1 FROM pg_type t
        JOIN pg_namespace n ON n.oid = t.typnamespace
        WHERE t.typname = 'wf_qs_result' AND n.nspname = '{{ p2d2_instance_schema }}'
    ) THEN
        CREATE TYPE {{ p2d2_instance_schema }}.wf_qs_result AS ENUM (
    'pass',
    'fail',
    'warning'
);
    END IF;
END$$;


ALTER TYPE {{ p2d2_instance_schema }}.wf_qs_result OWNER TO "{{ p2d2_admin_role }}";

DO $$
BEGIN
    IF NOT EXISTS (
        SELECT 1 FROM pg_type t
        JOIN pg_namespace n ON n.oid = t.typnamespace
        WHERE t.typname = 'wf_session_state' AND n.nspname = '{{ p2d2_instance_schema }}'
    ) THEN
        CREATE TYPE {{ p2d2_instance_schema }}.wf_session_state AS ENUM (
    'active',
    'paused',
    'completed',
    'expired',
    'aborted'
);
    END IF;
END$$;


ALTER TYPE {{ p2d2_instance_schema }}.wf_session_state OWNER TO "{{ p2d2_admin_role }}";

DO $$
BEGIN
    IF NOT EXISTS (
        SELECT 1 FROM pg_type t
        JOIN pg_namespace n ON n.oid = t.typnamespace
        WHERE t.typname = 'wf_snapshot_kind' AND n.nspname = '{{ p2d2_instance_schema }}'
    ) THEN
        CREATE TYPE {{ p2d2_instance_schema }}.wf_snapshot_kind AS ENUM (
    'auto',
    'manual',
    'session_boundary',
    'pre_qs',
    'post_qs',
    'export'
);
    END IF;
END$$;


ALTER TYPE {{ p2d2_instance_schema }}.wf_snapshot_kind OWNER TO "{{ p2d2_admin_role }}";


