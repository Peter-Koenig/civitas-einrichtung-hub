    fs.state::text AS workflow_status,
    fs.last_session_id AS letzte_session_id
   FROM {{ p2d2_instance_schema }}.p2d2_graeber g
     LEFT JOIN {{ p2d2_instance_schema }}.p2d2_graeber_versionen v ON v.grab_id = g.p2d2_uuid
     LEFT JOIN {{ p2d2_instance_schema }}.wf_feature_status fs ON fs.feature_id = g.p2d2_uuid AND fs.feature_type = 'grab'::text
  ORDER BY g.p2d2_uuid, v.version_nr DESC NULLS LAST;;


