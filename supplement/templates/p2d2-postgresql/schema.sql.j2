CREATE OR REPLACE TRIGGER trg_version_delete AFTER DELETE ON {{ p2d2_instance_schema }}.p2d2_grabflure_versionen FOR EACH ROW EXECUTE FUNCTION {{ p2d2_instance_schema }}.on_version_delete();

-- de1-Zusatz: fn_container_mitversionen() + trg_container_mitversionen

CREATE OR REPLACE FUNCTION {{ p2d2_instance_schema }}.fn_container_mitversionen()
 RETURNS trigger
 LANGUAGE plpgsql
AS $function$
BEGIN
    -- Guard 1: Version-0-Anlage durch ensureVersion0() → nichts tun
    -- Guard 2: Mitversion, die dieser Trigger selbst angelegt hat → keine Rekursion
    IF NEW.version_nr = 0 OR NEW.is_session_boundary = FALSE THEN
        RETURN NEW;
    END IF;

    EXECUTE format(
        $sql$
        INSERT INTO %I.p2d2_grabflure_versionen (
            grabflur_id,
            version_nr,
            session_id,
            is_session_boundary,
            created_at,
            created_by,
            edit_comment,
            geom,
            id_intern,
            id_import,
            fh_nr,
            fh_name,
            flur_nr,
            wp_name,
            kommune_id
        )
        SELECT
            v.p2d2_uuid::uuid,
            $1,
            $2,
            FALSE,
            now(),
            $3,
            'Mitversion Session ' || $2,
            v.geom,
            v.id_intern,
            NULL,
            v.fh_nr,
            v.fh_name,
            v.flur_nr,
            v.wp_name,
            v.kommune_id
        FROM %I.v_grabflure_aktuell v
        WHERE
            v.fh_nr = $4
            AND v.p2d2_uuid::uuid <> $5
            -- Noch keine Zeile dieser Grabflur in dieser Session vorhanden
            AND NOT EXISTS (
                SELECT 1
                FROM %I.p2d2_grabflure_versionen ex
                WHERE ex.grabflur_id = v.p2d2_uuid::uuid
                  AND ex.session_id  = $2
            )
        $sql$,
        TG_TABLE_SCHEMA,
        TG_TABLE_SCHEMA,
        TG_TABLE_SCHEMA
    )
    USING
        NEW.version_nr,
        NEW.session_id,
        NEW.created_by,
        NEW.fh_nr,
        NEW.grabflur_id;

    RETURN NEW;
END;
$function$;


ALTER FUNCTION {{ p2d2_instance_schema }}.fn_container_mitversionen() OWNER TO "{{ p2d2_admin_role }}";

CREATE OR REPLACE TRIGGER trg_container_mitversionen AFTER INSERT ON {{ p2d2_instance_schema }}.p2d2_grabflure_versionen FOR EACH ROW EXECUTE FUNCTION {{ p2d2_instance_schema }}.fn_container_mitversionen();
