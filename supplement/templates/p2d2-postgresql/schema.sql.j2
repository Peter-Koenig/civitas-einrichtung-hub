CREATE OR REPLACE FUNCTION {{ p2d2_instance_schema }}.aggregate_session_snapshots(p_session_id bigint)
 RETURNS integer
 LANGUAGE plpgsql
AS $function$
DECLARE
    v_count INTEGER;
BEGIN
    INSERT INTO {{ p2d2_instance_schema }}.p2d2_graeber_versionen (
        grab_id, version_nr, session_id, is_session_boundary,
        created_at, created_by, edit_comment,
        geom, id_intern, id_import, probleme,
        fried_nr, fried_name, grabflur, grabnummer,
        grabart, grabart_key, anzahl_grabstellen,
        sperrung, gkey, nachname, vorname,
        geburtsdatum, sterbedatum, satzschluessel,
        grabstaette_status, bestattungsart,
        osm_raw_data, osm_merge_note,
        osm_id, osm_changeset_id, osm_version, kommune_id
    )
    SELECT DISTINCT ON (s.grab_id)
        s.grab_id,
        COALESCE(
            (SELECT MAX(v.version_nr)
               FROM {{ p2d2_instance_schema }}.p2d2_graeber_versionen v
              WHERE v.grab_id = s.grab_id),
            -1
        ) + 1,
        p_session_id,
        TRUE,
        now(), s.created_by, s.edit_comment,
        s.geom, s.id_intern, s.id_import, s.probleme,
        s.fried_nr, s.fried_name, s.grabflur, s.grabnummer,
        s.grabart, s.grabart_key, s.anzahl_grabstellen,
        s.sperrung, s.gkey, s.nachname, s.vorname,
        s.geburtsdatum, s.sterbedatum, s.satzschluessel,
        s.grabstaette_status, s.bestattungsart,
        s.osm_raw_data, s.osm_merge_note,
        s.osm_id, s.osm_changeset_id, s.osm_version, s.kommune_id
    FROM {{ p2d2_instance_schema }}.p2d2_graeber_snapshots s
    WHERE s.session_id = p_session_id
    ORDER BY s.grab_id, s.created_at DESC;

    GET DIAGNOSTICS v_count = ROW_COUNT;

    UPDATE {{ p2d2_instance_schema }}.wf_snapshots
       SET is_final = TRUE
     WHERE session_id = p_session_id
       AND version_table = 'p2d2_graeber_snapshots';

    RETURN v_count;
END;
$function$;


ALTER FUNCTION {{ p2d2_instance_schema }}.aggregate_session_snapshots(bigint) OWNER TO "{{ p2d2_admin_role }}";
CREATE OR REPLACE FUNCTION {{ p2d2_instance_schema }}.on_version_delete()
 RETURNS trigger
 LANGUAGE plpgsql
AS $function$
BEGIN
  DELETE FROM {{ p2d2_instance_schema }}.wf_snapshots WHERE version_id = OLD.version_id;
  UPDATE {{ p2d2_instance_schema }}.wf_sessions SET state='aborted', ended_at=now()
    WHERE id=OLD.session_id AND state IN ('active','completed');
  UPDATE {{ p2d2_instance_schema }}.wf_feature_status
    SET state='unbearbeitet', last_session_id=NULL, updated_at=now()
    WHERE feature_id=OLD.grabflur_id AND last_session_id=OLD.session_id;
  RETURN OLD;
END;
$function$;


