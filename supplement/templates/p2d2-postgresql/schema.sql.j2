    COALESCE(v.anzahl_grabstellen, g.anzahl_grabstellen) AS anzahl_grabstellen,
    COALESCE(v.sperrung, g.sperrung) AS sperrung,
    COALESCE(v.gkey, g.gkey) AS gkey,
    COALESCE(v.nachname, g.nachname) AS nachname,
    COALESCE(v.vorname, g.vorname) AS vorname,
    COALESCE(v.geburtsdatum, g.geburtsdatum) AS geburtsdatum,
    COALESCE(v.sterbedatum, g.sterbedatum) AS sterbedatum,
