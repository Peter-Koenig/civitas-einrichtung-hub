CREATE OR REPLACE VIEW {{ p2d2_instance_schema }}.v_grabflure_aktuell AS
 SELECT g.p2d2_uuid::text AS p2d2_uuid,
    COALESCE(v.geom, g.geom) AS geom,
    g.id_intern,
    g.fh_nr,
    g.fh_name,
    g.flur_nr,
    g.wp_name,
    g.kommune_id,
    g.created_at,
    g.updated_at,
    v.version_nr,
    v.version_id AS aktuelle_version_id,
    v.session_id AS aktuelle_session_id,
    v.edit_comment AS version_kommentar,
    v.created_at AS version_erstellt_am,
    v.created_by AS version_erstellt_von,
    COALESCE(fs.state::text, 'unbearbeitet'::text) AS workflow_status,
    fs.last_session_id AS letzte_session_id
   FROM {{ p2d2_instance_schema }}.p2d2_grabflure g
     LEFT JOIN LATERAL ( SELECT gv.version_id,
            gv.grabflur_id,
            gv.version_nr,
            gv.session_id,
            gv.is_session_boundary,
            gv.created_at,
            gv.created_by,
            gv.edit_comment,
            gv.geom,
            gv.id_intern,
            gv.id_import,
            gv.fh_nr,
            gv.fh_name,
            gv.flur_nr,
            gv.wp_name,
            gv.kommune_id
           FROM {{ p2d2_instance_schema }}.p2d2_grabflure_versionen gv
          WHERE gv.grabflur_id = g.p2d2_uuid
          ORDER BY gv.version_nr DESC
         LIMIT 1) v ON true
     LEFT JOIN {{ p2d2_instance_schema }}.wf_feature_status fs ON fs.feature_id = g.p2d2_uuid AND fs.feature_type = 'grabflur'::text;;


