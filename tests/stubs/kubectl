#!/usr/bin/env bash
# Stub für kubectl. Steuerung über KUBECTL_MODE:
#   ok              → alle get-Aufrufe liefern 0 (kein Output)
#   no_ns           → "get namespace" liefert Fehler
#   no_secret       → "get secret" liefert Fehler
#   no_clusterissuer→ "get clusterissuer" liefert Fehler
#   issuer_ready    → "get clusterissuer ... -o jsonpath" liefert "True"
# Optional: KUBECTL_CALL_LOG protokolliert jeden Aufruf (eine Zeile je Aufruf).
# Optional: KUBECTL_SCRIPT=<datei> delegiert jeden Aufruf an das Skript
# (volle Kontrolle für szenariobasierte Tests, z. B. cico-shutdown).
if [[ -n "${KUBECTL_CALL_LOG:-}" ]]; then
  echo "$*" >> "${KUBECTL_CALL_LOG}"
fi
if [[ -n "${KUBECTL_SCRIPT:-}" ]]; then
  exec bash "${KUBECTL_SCRIPT}" "$@"
fi
case "${KUBECTL_MODE:-ok}" in
  no_ns)
    case "$*" in
      *"get namespace"*) exit 1 ;;
    esac
    ;;
  no_secret)
    case "$*" in
      *"get secret"*) exit 1 ;;
    esac
    ;;
  no_clusterissuer)
    case "$*" in
      *"get clusterissuer"*) exit 1 ;;
    esac
    ;;
  issuer_ready)
    case "$*" in
      *"get clusterissuer"*"jsonpath"*) echo "True" ;;
    esac
    ;;
esac
exit 0
