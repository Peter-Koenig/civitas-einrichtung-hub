# p2d2-civitas-addon — .env-Template für die VOLLSTÄNDIGE p2d2-Frontend-Konfiguration.
#
# Diese Datei ist die einzige Quelle für ALLE Variablen (ConfigMaps UND Secrets) des
# p2d2-Frontends in CIVITAS/CORE — Basis + 5 Stages (main/dev/de1/de2/fv).
#
# Verwendung:
#   1) cp env.p2d2-addon.example .env.p2d2-addon   # NICHT committen!
#   2) Secret-Werte eintragen (die ConfigMap-Werte sind bereits vorbelegt).
#   3) set -a; source .env.p2d2-addon; set +a
#   4) ./p2d2-addon_env_vars.sh
#
# Sicherheit: Diese Datei enthält KEINE echten Secret-Werte. Die befüllte .env niemals
# committen (tmp/ ist git-ignoriert). Quelle/Kategorie: p2d2/k8s/VARIABLES.md.
#
# Wichtig:
#   - OIDC_* sind OPTIONAL („erst nach Keycloak-Provisionierung befüllen"); leer lassen,
#     bis der Keycloak-Realm/-Client existiert. Leere OIDC-Werte werden übersprungen.
#   - Alles andere ist PFLICHT: leere/CHANGEME-Werte führen zum Abbruch des Skripts.
#   - DB-Passwörter (P2D2_ADMIN_DB_PASSWORD, P2D2_RO_DB_PASSWORD, P2D2_<STAGE>_DB_PASSWORD)
#     dürfen leer bleiben: leer = wird bei der Installation erzeugt und hier gespiegelt.
#   - WFS-T-Passwörter (P2D2_<STAGE>_WFST_PASSWORD) dürfen ebenfalls leer bleiben: leer = wird erzeugt und im Secret
#     p2d2-geoserver-wfst-<stage> gespeichert (nicht in der .env gespiegelt); ein gesetzter Wert wird übernommen.
#   - „WFST_WORKSPACE" gilt zugleich als PUBLIC_WFST_WORKSPACE,
#     „WFST_ENDPOINT" zugleich als WFST_ENDPOINT_<KEY>,
#     „WFST_USERNAME" zugleich als WFST_USER_<KEY>,
#     „WFST_PASSWORD" zugleich als WFST_PW_<KEY>. Gleiche Werte nicht doppelt pflegen.
#   - Stage-ID „DEVELOP" entspricht der Stage „dev" (Secret p2d2-dev-secret).

# ============================================================================
# Basis-ConfigMap (p2d2-base-config) — nicht-sensibel, vorbelegt
# ============================================================================

# DOMAIN_NAME="data-dna.eu"
export DOMAIN_NAME="CHANGEME.example.org"
export ADDON_DOMAIN="udp.CHANGEME.example.org"

P2D2_BASE_APP_DEBUG=false                                        # K1 (.env.base)
P2D2_BASE_DEFAULT_CATEGORY_ICON=Fahnenmasten.svg                 # K1 (.env.base; Datei prüfen)
P2D2_BASE_DB_HOST=central-db.cc-prd-database-stack.svc.cluster.local   # K1-adaptiert
P2D2_BASE_DB_PORT=5432                                           # K1
P2D2_BASE_DB_NAME=p2d2                                           # K1-adaptiert (verifiziert)
P2D2_BASE_WFST_NAMESPACE=urn:data-dna:govdata                     # K1
P2D2_BASE_PUBLIC_WFST_ENDPOINT=https://geoportal.udp.CHANGEME.example.org/geoserver/ows   # K1-adaptiert
P2D2_BASE_PUBLIC_MAPSERVER_URL=https://geoportal.udp.CHANGEME.example.org/mapserver       # K1-adaptiert
P2D2_BASE_SMTP_HOST=mxe860.netcup.net                             # K1
P2D2_BASE_SMTP_PORT=587                                          # K1
P2D2_BASE_SMTP_SECURE=false                                      # K1
P2D2_BASE_SMTP_USER="CHANGEME"                                    # K1
P2D2_BASE_CONTACT_EMAIL_TO=peter.koenig@scanea.de                # K1
P2D2_BASE_CONTACT_EMAIL_FROM=p2d2-prod@scanea.de                 # K1

# ── DB-Admin-/RO-Passwörter (gemeinsame Datenbank-Rollen) ─────────────────────
# leer = wird bei der Installation erzeugt und hier gespiegelt
export P2D2_ADMIN_DB_PASSWORD=""
export P2D2_RO_DB_PASSWORD=""

P2D2_DEMO_PASSWORD="CHANGEME"

# ============================================================================
# Basis-Secret (p2d2-base-secret) — sensibel, PFLICHT außer OIDC
# ============================================================================
P2D2_BASE_ALTCHA_HMAC_KEY="CHANGEME"
P2D2_BASE_SMTP_PASS="CHANGEME"
P2D2_BASE_OIDC_ISSUER=https://idm.udp.CHANGEME.example.org/realms/cc-prd  # K3 — OPTIONAL, erst nach Keycloak
P2D2_BASE_OIDC_CLIENT_ID=                                        # K3 — OPTIONAL, erst nach Keycloak
P2D2_BASE_OIDC_CLIENT_SECRET="CHANGEME"

# ============================================================================
# Shared Infra-Secrets — OSM-IdP-Broker fuer Keycloak (OPTIONAL, erst nach Keycloak)
# ============================================================================
P2D2_OSM_IDP_CLIENT_ID="CHANGEME"     # K3 — von OSM (oauth2/applications)
P2D2_OSM_IDP_CLIENT_SECRET="CHANGEME"

# ============================================================================
# Stage „main" (ConfigMap p2d2-main-config / Secret p2d2-main-secret)
# ============================================================================
P2D2_MAIN_DB_USER=P2D2-MAIN                                      # K1
P2D2_MAIN_WFST_WORKSPACE=main                                    # K1
P2D2_MAIN_PUBLIC_SITE_URL=https://www.udp.CHANGEME.example.org   # K1-adaptiert
P2D2_MAIN_WFST_ENDPOINT=https://geoportal.udp.CHANGEME.example.org/geoserver/main/ows   # K1-adaptiert
P2D2_MAIN_WFST_USERNAME=p2d2_wfst_main                           # K1
P2D2_MAIN_DB_PASSWORD=""                                         # leer = wird bei der Installation erzeugt und hier gespiegelt
P2D2_MAIN_WFST_PASSWORD=""   # leer = wird erzeugt und im Secret p2d2-geoserver-wfst-<stage> gespeichert (nicht in .env gespiegelt)
P2D2_MAIN_SESSION_SECRET="CHANGEME"

# ============================================================================
# Stage „dev" (Stage-ID DEVELOP; ConfigMap p2d2-dev-config / Secret p2d2-dev-secret)
# ============================================================================
P2D2_DEVELOP_DB_USER=P2D2-DEVELOP                                # K1
P2D2_DEVELOP_WFST_WORKSPACE=dev                                  # K1
P2D2_DEVELOP_PUBLIC_SITE_URL=https://dev.udp.CHANGEME.example.org # K1-adaptiert
P2D2_DEVELOP_WFST_ENDPOINT=https://geoportal.udp.CHANGEME.example.org/geoserver/dev/ows   # K1-adaptiert
P2D2_DEVELOP_WFST_USERNAME=p2d2_wfst_develop                     # K1
P2D2_DEVELOP_DB_PASSWORD=""                                      # leer = wird bei der Installation erzeugt und hier gespiegelt
P2D2_DEVELOP_WFST_PASSWORD=""   # leer = wird erzeugt und im Secret p2d2-geoserver-wfst-<stage> gespeichert (nicht in .env gespiegelt)
P2D2_DEVELOP_SESSION_SECRET="CHANGEME"

# ============================================================================
# Stage „de1" (ConfigMap p2d2-f-de1-config / Secret p2d2-f-de1-secret)
# ============================================================================
P2D2_DE1_DB_USER=P2D2-DE1                                        # K1
P2D2_DE1_WFST_WORKSPACE=de1                                      # K1
P2D2_DE1_PUBLIC_SITE_URL=https://f-de1.udp.CHANGEME.example.org  # K1-adaptiert
P2D2_DE1_WFST_ENDPOINT=https://geoportal.udp.CHANGEME.example.org/geoserver/de1/ows   # K1-adaptiert
P2D2_DE1_WFST_USERNAME=p2d2_wfst_de1                             # K1
P2D2_DE1_DB_PASSWORD=""                                          # leer = wird bei der Installation erzeugt und hier gespiegelt
P2D2_DE1_WFST_PASSWORD=""   # leer = wird erzeugt und im Secret p2d2-geoserver-wfst-<stage> gespeichert (nicht in .env gespiegelt)
P2D2_DE1_SESSION_SECRET="CHANGEME"

# ============================================================================
# Stage „de2" (ConfigMap p2d2-f-de2-config / Secret p2d2-f-de2-secret)
# ============================================================================
P2D2_DE2_DB_USER=P2D2-DE2                                        # K1
P2D2_DE2_WFST_WORKSPACE=de2                                      # K1
P2D2_DE2_PUBLIC_SITE_URL=https://f-de2.udp.CHANGEME.example.org  # K1-adaptiert
P2D2_DE2_WFST_ENDPOINT=https://geoportal.udp.CHANGEME.example.org/geoserver/de2/ows   # K1-adaptiert
P2D2_DE2_WFST_USERNAME=p2d2_wfst_de2                             # K1
P2D2_DE2_DB_PASSWORD=""                                          # leer = wird bei der Installation erzeugt und hier gespiegelt
P2D2_DE2_WFST_PASSWORD=""   # leer = wird erzeugt und im Secret p2d2-geoserver-wfst-<stage> gespeichert (nicht in .env gespiegelt)
P2D2_DE2_SESSION_SECRET="CHANGEME"

# ============================================================================
# Stage „fv" (ConfigMap p2d2-f-fv-config / Secret p2d2-f-fv-secret)
# ============================================================================
P2D2_FV_DB_USER=P2D2-FV                                          # K1
P2D2_FV_WFST_WORKSPACE=fv                                        # K1
P2D2_FV_PUBLIC_SITE_URL=https://f-fv.udp.CHANGEME.example.org    # K1-adaptiert
P2D2_FV_WFST_ENDPOINT=https://geoportal.udp.CHANGEME.example.org/geoserver/fv/ows   # K1-adaptiert
P2D2_FV_WFST_USERNAME=p2d2_wfst_fv                               # K1
P2D2_FV_DB_PASSWORD=""                                           # leer = wird bei der Installation erzeugt und hier gespiegelt
P2D2_FV_WFST_PASSWORD=""   # leer = wird erzeugt und im Secret p2d2-geoserver-wfst-<stage> gespeichert (nicht in .env gespiegelt)
P2D2_FV_SESSION_SECRET="CHANGEME"

# ============================================================================
# Shared Infra-Secrets — Git-Pull-Tokens + Webhook-Auth (OPTIONAL als Gruppe)
# Nur geschrieben, wenn ALLE vier gesetzt sind; sonst bleiben bestehende Werte erhalten.
# ============================================================================
P2D2_GITLAB_TOKEN="CHANGEME"
P2D2_GITHUB_TOKEN="CHANGEME"
P2D2_GITLAB_WEBHOOK_TOKEN="CHANGEME"
P2D2_GITHUB_HMAC_SECRET="CHANGEME"
