# =============================================================================
# p2d2-AddOn (CIVITAS/CORE V1s) — Vorlage für .env.p2d2-addon
# =============================================================================
# Diese Datei ist die versionierte Vorlage. Die echte Konfiguration liegt
# ausserhalb des Repos und wird nicht committet (sie steht in .gitignore).
#
# Ablageort:
#   Standard: <Repo-Root>/../.env.p2d2-addon
#   Das Skript erwartet die echte Datei im Elternverzeichnis des Repos
#   (${SCRIPT_DIR}/../.env.p2d2-addon).
#
# Host-Kontext:
#   Das AddOn liest vor dem Host→VM-Hop ausschliesslich ADDON_SSH_KEY_FILE.
#   Alle übrigen Werte werden erst im VM-Kontext geladen.
#
# VM-Kontext:
#   Das Skript kopiert die echte Datei ins Elternverzeichnis von
#   VM_REMOTE_INSTALL_DIR, setzt dort Modus 0600 und lädt sie mit
#   `set -a; source .env.p2d2-addon; set +a`.
#
# Alle Werte sind Platzhalter oder nicht-sensitive Beispiele. Vor dem Einsatz
# durch echte Werte ersetzen. Keine echten Secrets in diese Vorlage.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Zielumgebung und Cluster
# -----------------------------------------------------------------------------
# DOMAIN_NAME ist Pflicht. ADDON_DOMAIN bleibt optional; ist es leer, wird
# später udp.${DOMAIN_NAME} abgeleitet. Ist es gesetzt, muss es exakt
# udp.${DOMAIN_NAME} entsprechen.
export DOMAIN_NAME="CHANGEME.example.org"
# export ADDON_DOMAIN=""
# export ADDON_NS="cc-prd-geodata-stack"
# export ADDON_DB_NS="cc-prd-database-stack"
# export ADDON_IAM_REALM="cc-prd"
# export ADDON_IAM_NS="cc-prd-access-stack"
# export ADDON_IAM_ADMIN_SECRET="cc-prd-keycloak-admin"
# export ADDON_MASTERPORTAL_SERVICE="masterportal"

# -----------------------------------------------------------------------------
# 2. SSH und Host→VM-Hop
# -----------------------------------------------------------------------------
# ADDON_SSH_KEY_FILE ist ein Pfad zum privaten Admin-Schlüssel auf dem HOST.
# Der Schlüsselinhalt gehört nie in diese Datei. INSTALL_KEY_DIR und
# ADDON_SSH_KNOWN_HOSTS spiegeln die Installer-Konvention (01_config.sh).
# export VM_IP_STATIC="192.168.12.139"
# export VM_ID="2010"
# export INSTALL_KEY_DIR=""
# export ADDON_SSH_KEY_FILE=""
# export ADDON_SSH_KNOWN_HOSTS=""
# export VM_REMOTE_INSTALL_DIR="/root/p2d2-addon"

# -----------------------------------------------------------------------------
# 3. Frontend-Basiswerte (nicht sensibel)
# -----------------------------------------------------------------------------
# Werden in diesem Turn nur dokumentiert und validiert. base.yaml bleibt
# unverändert; die Verwendung folgt in Schritt 2b.
export P2D2_BASE_APP_DEBUG="false"
export P2D2_BASE_DEFAULT_CATEGORY_ICON="Fahnenmasten.svg"
export P2D2_BASE_DB_HOST="central-db.cc-prd-database-stack.svc.cluster.local"
export P2D2_BASE_DB_PORT="5432"
export P2D2_BASE_DB_NAME="p2d2"
export P2D2_BASE_WFST_NAMESPACE="urn:example:govdata"
export P2D2_BASE_PUBLIC_WFST_ENDPOINT="https://geoportal.udp.CHANGEME.example.org/geoserver/ows"
export P2D2_BASE_PUBLIC_MAPSERVER_URL="https://geoportal.udp.CHANGEME.example.org/mapserver"
export P2D2_BASE_SMTP_HOST="smtp.example.org"
export P2D2_BASE_SMTP_PORT="587"
export P2D2_BASE_SMTP_SECURE="false"
export P2D2_BASE_SMTP_USER="CHANGEME"
export P2D2_BASE_CONTACT_EMAIL_TO="admin@example.org"
export P2D2_BASE_CONTACT_EMAIL_FROM="noreply@example.org"

# -----------------------------------------------------------------------------
# 4. Frontend-Basis-Secret
# -----------------------------------------------------------------------------
# P2D2_BASE_ALTCHA_HMAC_KEY und P2D2_BASE_SMTP_PASS sind Pflicht.
# P2D2_BASE_OIDC_ISSUER, P2D2_BASE_OIDC_CLIENT_ID und P2D2_BASE_OIDC_CLIENT_SECRET
# sind in diesem Turn optional (Schritt 2d/IAM kann sie erzeugen). Die bestehende
# Runtime-Pflichtprüfung für P2D2_BASE_OIDC_ISSUER bleibt bis Schritt 2d unverändert.
export P2D2_BASE_ALTCHA_HMAC_KEY="CHANGEME"
export P2D2_BASE_SMTP_PASS="CHANGEME"
export P2D2_BASE_OIDC_ISSUER=""
# export P2D2_BASE_OIDC_CLIENT_ID=""
# export P2D2_BASE_OIDC_CLIENT_SECRET=""

# -----------------------------------------------------------------------------
# 5. Stage-Werte
# -----------------------------------------------------------------------------
# Für MAIN, DEVELOP, DE1, DE2 und FV jeweils dieselben Felder. Der <KEY> ist bei
# DEVELOP genau "DEVELOP" (nicht DEV). Zuordnung:
#   MAIN/main/www, DEVELOP/dev/dev, DE1/de1/f-de1, DE2/de2/f-de2, FV/fv/f-fv
#
# MAIN
export P2D2_MAIN_DB_USER="P2D2-MAIN"
export P2D2_MAIN_WFST_WORKSPACE="main"
export P2D2_MAIN_PUBLIC_SITE_URL="https://www.udp.CHANGEME.example.org"
export P2D2_MAIN_WFST_ENDPOINT="https://geoportal.udp.CHANGEME.example.org/geoserver/main/ows"
export P2D2_MAIN_WFST_USERNAME="p2d2_wfst_main"
export P2D2_MAIN_DB_PASSWORD="CHANGEME"
export P2D2_MAIN_WFST_PASSWORD="CHANGEME"
export P2D2_MAIN_SESSION_SECRET="CHANGEME"
# DEVELOP
export P2D2_DEVELOP_DB_USER="P2D2-DEVELOP"
export P2D2_DEVELOP_WFST_WORKSPACE="dev"
export P2D2_DEVELOP_PUBLIC_SITE_URL="https://dev.udp.CHANGEME.example.org"
export P2D2_DEVELOP_WFST_ENDPOINT="https://geoportal.udp.CHANGEME.example.org/geoserver/dev/ows"
export P2D2_DEVELOP_WFST_USERNAME="p2d2_wfst_develop"
export P2D2_DEVELOP_DB_PASSWORD="CHANGEME"
export P2D2_DEVELOP_WFST_PASSWORD="CHANGEME"
export P2D2_DEVELOP_SESSION_SECRET="CHANGEME"
# DE1
export P2D2_DE1_DB_USER="P2D2-DE1"
export P2D2_DE1_WFST_WORKSPACE="de1"
export P2D2_DE1_PUBLIC_SITE_URL="https://f-de1.udp.CHANGEME.example.org"
export P2D2_DE1_WFST_ENDPOINT="https://geoportal.udp.CHANGEME.example.org/geoserver/de1/ows"
export P2D2_DE1_WFST_USERNAME="p2d2_wfst_de1"
export P2D2_DE1_DB_PASSWORD="CHANGEME"
export P2D2_DE1_WFST_PASSWORD="CHANGEME"
export P2D2_DE1_SESSION_SECRET="CHANGEME"
# DE2
export P2D2_DE2_DB_USER="P2D2-DE2"
export P2D2_DE2_WFST_WORKSPACE="de2"
export P2D2_DE2_PUBLIC_SITE_URL="https://f-de2.udp.CHANGEME.example.org"
export P2D2_DE2_WFST_ENDPOINT="https://geoportal.udp.CHANGEME.example.org/geoserver/de2/ows"
export P2D2_DE2_WFST_USERNAME="p2d2_wfst_de2"
export P2D2_DE2_DB_PASSWORD="CHANGEME"
export P2D2_DE2_WFST_PASSWORD="CHANGEME"
export P2D2_DE2_SESSION_SECRET="CHANGEME"
# FV
export P2D2_FV_DB_USER="P2D2-FV"
export P2D2_FV_WFST_WORKSPACE="fv"
export P2D2_FV_PUBLIC_SITE_URL="https://f-fv.udp.CHANGEME.example.org"
export P2D2_FV_WFST_ENDPOINT="https://geoportal.udp.CHANGEME.example.org/geoserver/fv/ows"
export P2D2_FV_WFST_USERNAME="p2d2_wfst_fv"
export P2D2_FV_DB_PASSWORD="CHANGEME"
export P2D2_FV_WFST_PASSWORD="CHANGEME"
export P2D2_FV_SESSION_SECRET="CHANGEME"

# -----------------------------------------------------------------------------
# 6. Optionaler OSM-IdP
# -----------------------------------------------------------------------------
# Der Schalter wird jetzt dokumentiert und validiert (true|false). Die
# funktionale Auswertung durch addon_25_iam.sh folgt erst in Schritt 2d.
# Solange dieser Turn allein aktiv ist, bleiben die bisherigen
# OSM-Pflichtprüfungen unverändert.
export P2D2_OSM_IDP_ENABLE="false"
# export P2D2_OSM_IDP_CLIENT_ID=""
# export P2D2_OSM_IDP_CLIENT_SECRET=""

# -----------------------------------------------------------------------------
# 7. Optionale Demo-Accounts
# -----------------------------------------------------------------------------
# Der Schalter wird jetzt dokumentiert und validiert (true|false). Die
# funktionale Auswertung folgt erst in Schritt 2d. Solange dieser Turn allein
# aktiv ist, bleibt die bisherige Pflichtprüfung für P2D2_DEMO_PASSWORD
# unverändert.
export P2D2_DEMO_ACCOUNTS="false"
# export P2D2_DEMO_PASSWORD=""

# -----------------------------------------------------------------------------
# 8. Git und Webhook
# -----------------------------------------------------------------------------
# Git-Tokens sind derzeit für die fünf Frontend-Builds erforderlich. Die
# funktionale Behandlung der Webhook-Werte bleibt unverändert.
export P2D2_GITLAB_TOKEN="CHANGEME"
export P2D2_GITHUB_TOKEN="CHANGEME"
# export P2D2_GITLAB_WEBHOOK_TOKEN=""
# export P2D2_GITHUB_HMAC_SECRET=""
