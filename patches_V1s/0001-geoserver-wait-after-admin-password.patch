--- a/core_platform/tasks/geodata/install/geoserver_setup_role_service.yml	2026-10-23 21:29:02.000000000 +0000
+++ b/core_platform/tasks/geodata/install/geoserver_setup_role_service.yml	2026-10-31 21:22:09.432537562 +0000
@@ -79,6 +79,15 @@
   retries: 30
   delay: 10
 
+# p2d2 V1s: GeoServer uebernimmt ein per REST gesetztes Admin-Passwort fuer Logins erst nach dem
+# naechsten Reload des Benutzerspeichers (Datei-Watcher fuer security/usergroup/default/users.xml).
+# Empirisch: das neue Passwort wird mind. ca. 2,8 s lang abgelehnt (HTTP 401); Watcher-Meldung
+# 3-4 s nach dem Speichern (Messung 31.10.2026, GeoServer 3.0.1). 10 s = ca. 2,5-facher Sicherheitsabstand.
+# Kein dokumentierter GeoServer-Wert; bei Upstream-Aenderung des Tasks neu bewerten.
+- name: "GeoServer: Wait until the new admin password is accepted"
+  ansible.builtin.wait_for:
+    timeout: 10
+
 - name: "GeoServer: Render and write role service config to pod"
   vars:
     role_service_name: "civitas-idm"
