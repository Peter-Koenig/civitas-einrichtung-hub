# ============================================================
# .env-v1s.local.example — CIVITAS/CORE V1s
# (V1s = CIVITAS/CORE V1 mit statischer Masterportal-Konfiguration)
#
# Enthält KEINE RustFS-/S3-Variablen: V1s liefert die Masterportal-Konfiguration
# ausschließlich über das per modules_V1s/06c_image_build.sh gebaute
# Portal-Backend-Image.
#
# Ablageort und Laden:
#   - Der Installer (Host-Zweig) sucht `${SCRIPT_DIR}/.env-v1s.local`
#     (Fallback `${SCRIPT_DIR}/.env.local`) und kopiert sie für den VM-Hop nach
#     /root/civitas-install/.env.local, wo sie gesourct wird. Auf dem Host wird
#     sie NICHT automatisch geladen.
#   - Vor dem Skriptaufruf auf dem Host:  set -a; source .env-v1s.local; set +a
#   - Liegt die Datei außerhalb von ${SCRIPT_DIR}, ist ein Symlink oder eine
#     Kopie nötig.
#   - `.env-v1s.local` NIE committen (enthält Secrets).
#
# Markierung: [Pflicht] = Skript bricht ohne diese Variable ab (siehe
# modules_V1s/01_config.sh, ${VAR:?…}). Variablen mit Default sind auskommentiert
# (# export NAME="Default"); die Defaults leben damit nur einmal, in 01_config.sh.
# ============================================================

# ── Steuerung / Debug (Default in 01_config.sh) ──────────────
# export CIVITAS_DEBUG="false"        # true = ausführliche Debug-Ausgabe
# export LE_CERT="false"              # false = nur Staging, true = Staging + Production
# export LE_REQUESTS_BLOCKED="false"  # true = keine neuen Zertifikatsanforderungen (Safety)
# export APISIX_DASHBOARD="false"     # true = APISIX-Dashboard aktivieren
# export RUN_TESTS="false"            # true = E2E-Tests nach Installation
# export CERT_BACKUP_FILE="le-certs-backup.yaml"  # Dateiname (relativ) oder Pfad IN DER VM; der Installer kopiert nur ${SCRIPT_DIR}/le-certs-backup.yaml
# export LOG_FILE=""                  # optionaler Pfad für File-Logging (Installer-Option)

# ── Domain ────────────────────────────────────────────────────
export DOMAIN_NAME="CHANGEME.example.eu"   # [Pflicht] Basis-Domain OHNE "udp."-Präfix; 01_config.sh bildet DOMAIN="udp.<DOMAIN_NAME>"

# ── Tests (E2E) ───────────────────────────────────────────────
# Vom Installer nicht gelesen; ggf. vom E2E-Testrepo verwendet (Verwendung nicht belegt).
# TEST_ID.BASE_DOMAIN entspricht DOMAIN.
# export TEST_ID="udp"
# export BASE_DOMAIN="example.eu"

# ── VM-Zugang ────────────────────────────────────────────────
export ROOT_PASSWORD="CHANGEME"             # [Pflicht] von 01_config.sh verlangt; wird derzeit von keinem Modul weiterverwendet (kein Passwort-Login in der VM)

# ── SMTP ─────────────────────────────────────────────────────
export SMTP_HOST="CHANGEME"                 # [Pflicht] SMTP-Server-Hostname
# export SMTP_PORT="587"                    # SMTP-Port
export SMTP_USER="CHANGEME"                 # [Pflicht] SMTP-Benutzer
export SMTP_PASS="CHANGEME"                 # [Pflicht] SMTP-Passwort

# ── Admin ────────────────────────────────────────────────────
# export ADMIN_EMAIL="admin@<DOMAIN_NAME>"  # E-Mail des Plattform-Administrators
export ADMIN_PASS="CHANGEME"                 # [Pflicht] master_password / platform_admin
# export TENANT_ADMIN_PASS=""              # derzeit von keinem Modul gelesen

# ── Netzwerkmodus / WireGuard ────────────────────────────────
export WG_ENABLE="true"                     # true (Default) = WireGuard aktiv; false = ohne WireGuard
export WG_VM_PRIVATE_KEY="CHANGEME"         # WireGuard-Private-Key der VM (Pflicht bei WG_ENABLE=true)
export WG_OPN_PUBLIC_KEY="CHANGEME"         # WireGuard-Public-Key der OPNsense (Pflicht bei WG_ENABLE=true)
export WG_OPN_ENDPOINT="CHANGEME:51820"     # öffentliche IP:Port der OPNsense/HAProxy (Pflicht bei WG_ENABLE=true)
# export WG_PRESHARED_KEY=""               # optionaler Pre-Shared-Key (leer = keine PreSharedKey-Zeile)
# export WG_LISTEN_PORT="51820"            # WireGuard-Listen-Port

# ── V1s-spezifisch (Default in 01_config.sh) ─────────────────
# export V1S_IMAGE_TAG="v1s-local"        # Tag des lokal gebauten Portal-Backend-Images

# ── Host / VM (Proxmox, Default in 01_config.sh) ─────────────
# export VM_ID="2010"                       # Proxmox VM-ID
# export VM_NAME="civitas-core"             # VM-Anzeigename
# export VM_RAM_MB="40960"                  # RAM in MiB
# export VM_CORES="12"                      # vCPUs
# export VM_DISK_GB="300"                   # Disk-Größe in GiB
# export VM_BRIDGE="vmbr0"                  # Bridge-Netzwerk
# export PROXMOX_STORAGE="local-zfs-civitas"  # Proxmox-Storage für die VM-Disk (leer = Default); unterstützt: zfspool, lvmthin
# export VM_IP_STATIC="192.168.12.139"      # IPv4-Adresse der VM
# export VM_IP_PREFIX="24"                  # IPv4-Präfixlänge
# export VM_GW="192.168.12.1"               # IPv4-Gateway
# export VM_IP6_STATIC="fd01:1:1:1::139"    # IPv6-Adresse der VM (leer = IPv6 deaktivieren)
# export VM_IP6_PREFIX="64"                 # IPv6-Präfixlänge
# export VM_GW6="fd01:1:1:1:de39:6fff:febe:9962"  # IPv6-Gateway
# export PBS_STORAGE="backup-p2d2-kinglui"  # PBS-Storage (leer = Backup-Prüfung überspringen)
# export CLOUD_IMAGE_URL="https://cloud.debian.org/images/cloud/trixie/daily/latest/debian-13-genericcloud-amd64-daily.qcow2"
# export CLOUD_IMAGE_CACHE="/var/lib/vz/template/qcow"
# export SOHO_GATEWAY="192.168.12.1"        # Gateway für check_network (Default = VM_GW)

# ── SSH-Zugang zur VM ────────────────────────────────────────
# Optional. Ein oder mehrere ÖFFENTLICHE Schlüssel (eine Zeile pro Key) für
# direkten Login als root. Das Skript erzeugt zusätzlich einen eigenen
# Installations-Key unter INSTALL_KEY_DIR.
# export VM_SSH_PUBKEY="ssh-ed25519 AAAA... user@workstation"
# export VM_REMOVE_INSTALL_KEY="false"   # true = Installations-Key am Ende aus der VM entfernen (nur mit VM_SSH_PUBKEY)
# export INSTALL_KEY_DIR=""              # Default: ${HOME}/.local/share/civitas-install/<VM_ID>

# ── Cluster / Kubernetes (optional, Default in 01_config.sh) ─
# export K3S_NODE_NAME=""                # k3s-Node-Name (Default: hostname)
# export CC_ENVIRONMENT="cc-prd"         # Ansible-Environment-Name (Muster {CC_ENVIRONMENT}-{stack})
# export K8S_CONTEXT="default"
# export STORAGECLASS_RWO="local-path"
# export STORAGECLASS_RWX="local-path"
# export STORAGECLASS_LOC="local-path"
# export INGRESS_CLASS="nginx"
# export CERT_MANAGER_ISSUER="selfsigned-issuer"
# export CREDENTIALS_OUTPUT_PATH="/root/civitas-install/credentials.env"

# ============================================================
# Beispielprofile
# ============================================================
# Profil A: "SOHO mit HAProxy/WireGuard"
#   WG_ENABLE="true"
#   PROXMOX_STORAGE="local-zfs-civitas"
#   VM_BRIDGE="vmbr0"
#   VM_CORES="12"
#   WG_VM_PRIVATE_KEY=…  WG_OPN_PUBLIC_KEY=…  WG_OPN_ENDPOINT=…  (setzen)
#
# Profil B: "Hetzner NAT ohne WireGuard"
#   WG_ENABLE="false"
#   PROXMOX_STORAGE="local-lvm"
#   VM_BRIDGE="vmbr1"
#   VM_CORES="10"
#   VM_GW="192.168.12.1"
#   VM_IP6_STATIC="fd01:1:1:1::139"
#   VM_GW6="fd01:1:1:1::1"
#   PBS_STORAGE=""
#   DOMAIN_NAME="projekte-koenig.eu"        # -> DOMAIN="udp.projekte-koenig.eu"
#   (zusätzlich VM_SSH_PUBKEY für direkten Login setzen)
