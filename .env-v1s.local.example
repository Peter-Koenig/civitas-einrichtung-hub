# ============================================================
# .env-v1s.local.example — CIVITAS/CORE V1s
# (V1s = CIVITAS/CORE V1 mit statischer Masterportal-Konfiguration)
#
# Vorlage für die lokale Secrets-/Konfigurationsdatei der V1s-Buildvariante.
# Enthält KEINE RustFS-/S3-Variablen: V1s liefert die Masterportal-
# Konfiguration ausschließlich über das per modules_V1s/06c_image_build.sh
# gebaute Portal-Backend-Image.
#
# Verwendung:
#   1. Nach .env.local kopieren (wird vom Skript automatisch erkannt) oder
#      manuell vor dem Start sourcen:  source .env.local
#   2. Alle Platzhalter (CHANGEME) durch echte Werte ersetzen.
#   3. .env.local NIE committen (enthält Secrets).
# ============================================================

# ── Pflichtvariablen (Skript bricht ohne diese ab) ───────────────────────────
export DOMAIN_NAME="CHANGEME.example.eu"          # Basis-Domain (z. B. example.eu)
export SMTP_HOST="CHANGEME"                        # SMTP-Server-Hostname
export SMTP_USER="CHANGEME"                        # SMTP-Benutzer
export SMTP_PASS="CHANGEME"                        # SMTP-Passwort
export ADMIN_PASS="CHANGEME"                       # Plattform-Admin (master_password)
export ROOT_PASSWORD="CHANGEME"                    # Root-Passwort der Ziel-VM
export WG_VM_PRIVATE_KEY="CHANGEME"                # WireGuard-Private-Key der VM
export WG_OPN_PUBLIC_KEY="CHANGEME"                # WireGuard-Public-Key der OPNsense
export WG_OPN_ENDPOINT="CHANGEME:51820"            # WireGuard-Endpoint (IP:Port der OPNsense)

# ── Optionale Variablen (Default-Werte in Klammern) ──────────────────────────
export SMTP_PORT="587"                              # SMTP-Port
export ADMIN_EMAIL="admin@CHANGEME.example.eu"     # E-Mail des Plattform-Administrators
export LE_CERT="false"                              # false = nur Staging, true = + Production
export LE_REQUESTS_BLOCKED="false"                  # true = keine neuen Zertifikatsanforderungen
export APISIX_DASHBOARD="false"                     # true = APISIX-Dashboard aktivieren
export RUN_TESTS="false"                            # true = E2E-Tests nach Installation
export CIVITAS_DEBUG="false"                        # true = ausführliche Debug-Ausgabe
export CERT_BACKUP_FILE="le-certs-backup.yaml"      # LE-Zertifikats-Backup (optional)
# export DOMAIN="udp.CHANGEME.example.eu"           # Überschreibt die berechnete Domain (optional)
# export TEST_ID="udp"                              # E2E-Test-Identifier (optional)
# export BASE_DOMAIN="example.eu"                   # E2E-Test-Basis-Domain (optional)
# export WG_PRESHARED_KEY=""                        # WireGuard-Pre-Shared-Key (optional)

# ── V1s-spezifisch ────────────────────────────────────────────────────────────
# Tag des lokal gebauten Portal-Backend-Images (Default: v1s-local).
# Empfehlung: datiert setzen, z. B. v1s-2026-08-26.
export V1S_IMAGE_TAG="v1s-local"
