# ============================================================
# .env-v1s.local.example — CIVITAS/CORE V1s
# (V1s = CIVITAS/CORE V1 mit statischer Masterportal-Konfiguration)
#
# Vorlage für die lokale Konfigurations-/Secrets-Datei der V1s-Buildvariante.
# Enthält KEINE RustFS-/S3-Variablen: V1s liefert die Masterportal-Konfiguration
# ausschließlich über das per modules_V1s/06c_image_build.sh gebaute
# Portal-Backend-Image.
#
# VERWENDUNG:
#   - Für install_civitas_core_V1s.sh: diese Datei als `.env-v1s.local` in das
#     Repo-Wurzelverzeichnis kopieren. Das Skript sucht
#     `${SCRIPT_DIR}/.env-v1s.local` (Fallback `${SCRIPT_DIR}/.env.local`) und
#     kopiert sie für den VM-Hop nach /root/civitas-install/.env.local.
#   - Alternativ vor dem Skriptaufruf manuell sourcen:  source .env-v1s.local
#   - `.env-v1s.local` NIE committen (enthält Secrets).
#
# Markierung: [Pflicht] = Skript bricht ohne diese Variable ab (siehe
# modules_V1s/01_config.sh). Alle übrigen Variablen sind optional; der Default
# steht im Kommentar bzw. in 01_config.sh.
# ============================================================

# ── Steuerung / Debug ─────────────────────────────────────────
export CIVITAS_DEBUG="false"        # true = ausführliche Debug-Ausgabe (optional)
export LE_CERT="false"              # false = nur Staging, true = Staging + Production (optional)
export LE_REQUESTS_BLOCKED="false"  # true = keine neuen Zertifikatsanforderungen (Safety, optional)
export APISIX_DASHBOARD="false"     # true = APISIX-Dashboard aktivieren (optional)
export RUN_TESTS="false"            # true = E2E-Tests nach Installation (optional)
export CERT_BACKUP_FILE="le-certs-backup.yaml"  # Pfad zum LE-Zertifikats-Backup (optional)

# ── Domain ────────────────────────────────────────────────────
export DOMAIN_NAME="CHANGEME.example.eu"   # [Pflicht] Basis-Domain OHNE "udp."-Präfix
                                            # 01_config.sh bildet daraus DOMAIN="udp.<DOMAIN_NAME>".
                                            # Ein zusätzliches "export DOMAIN=…" ist wirkungslos und entfällt.

# ── Tests (E2E, optional) ─────────────────────────────────────
export TEST_ID="udp"                        # E2E-Test-Identifier
export BASE_DOMAIN="CHANGEME.example.eu"    # E2E-Test-Basis-Domain

# ── VM-Zugang ────────────────────────────────────────────────
export ROOT_PASSWORD="CHANGEME"             # [Pflicht] Root-Passwort der Ziel-VM

# ── SMTP ─────────────────────────────────────────────────────
export SMTP_HOST="CHANGEME"                 # [Pflicht] SMTP-Server-Hostname
export SMTP_PORT="587"                      # SMTP-Port (optional, Default 587)
export SMTP_USER="CHANGEME"                 # [Pflicht] SMTP-Benutzer
export SMTP_PASS="CHANGEME"                 # [Pflicht] SMTP-Passwort

# ── Admin ────────────────────────────────────────────────────
export ADMIN_EMAIL="admin@CHANGEME.example.eu"  # E-Mail des Plattform-Administrators (optional, Default admin@<DOMAIN_NAME>)
export ADMIN_PASS="CHANGEME"                 # [Pflicht] master_password / platform_admin
# export TENANT_ADMIN_PASS="CHANGEME"        # derzeit von keinem Modul gelesen (reserviert)

# ── Netzwerkmodus / WireGuard ────────────────────────────────
export WG_ENABLE="true"                     # true (Default) = WireGuard aktiv; false = ohne WireGuard
# Bei WG_ENABLE=false dürfen die folgenden WG_* leer bleiben (werden ignoriert):
export WG_VM_PRIVATE_KEY="CHANGEME"         # WireGuard-Private-Key der VM (Pflicht bei WG_ENABLE=true)
export WG_OPN_PUBLIC_KEY="CHANGEME"         # WireGuard-Public-Key der OPNsense (Pflicht bei WG_ENABLE=true)
export WG_PRESHARED_KEY="CHANGEME"          # WireGuard-Pre-Shared-Key (optional)
export WG_OPN_ENDPOINT="CHANGEME:51820"     # öffentliche IP:Port der OPNsense/HAProxy (Pflicht bei WG_ENABLE=true)

# ── V1s-spezifisch ───────────────────────────────────────────
# Tag des lokal gebauten Portal-Backend-Images (optional, Default v1s-local).
# Empfehlung: datiert setzen, z. B. v1s-2026-10-01.
export V1S_IMAGE_TAG="v1s-local"

# ── Host / VM (Proxmox, optional) ────────────────────────────
export VM_ID="2010"                         # Proxmox VM-ID
export VM_NAME="civitas-core"               # VM-Anzeigename
export VM_RAM_MB="40960"                    # RAM in MiB
export VM_CORES="12"                        # vCPUs
export VM_DISK_GB="300"                     # Disk-Größe in GiB
export VM_BRIDGE="vmbr0"                    # Bridge-Netzwerk
export PROXMOX_STORAGE="local-zfs-civitas"  # Proxmox-Storage für VM-Disk (leer = Fehler)
export VM_IP_STATIC="192.168.12.139"        # IPv4-Adresse der VM
export VM_IP_PREFIX="24"                    # IPv4-Präfixlänge
export VM_GW="192.168.12.1"                 # IPv4-Gateway
export VM_IP6_STATIC="fd01:1:1:1::139"      # IPv6-Adresse der VM (leer = IPv6 deaktivieren)
export VM_IP6_PREFIX="64"                   # IPv6-Präfixlänge
export VM_GW6="fd01:1:1:1:de39:6fff:febe:9962"  # IPv6-Gateway
export PBS_STORAGE="backup-p2d2-kinglui"    # PBS-Storage (leer = Backup-Prüfung überspringen)
export CLOUD_IMAGE_URL="https://cloud.debian.org/images/cloud/trixie/daily/latest/debian-13-genericcloud-amd64-daily.qcow2"
export SOHO_GATEWAY="192.168.12.1"          # Gateway für check_network (optional, Default = VM_GW)

# ============================================================
# Beispielprofile
# ============================================================
# Profil A: "SOHO mit HAProxy/WireGuard" (bisherige Umgebung)
#   WG_ENABLE="true"
#   PROXMOX_STORAGE="local-zfs-civitas"
#   VM_BRIDGE="vmbr0"
#   VM_CORES="12"
#   WG_VM_PRIVATE_KEY=…  WG_OPN_PUBLIC_KEY=…  WG_OPN_ENDPOINT=…  (setzen)
#
# Profil B: "Hetzner NAT ohne WireGuard"
#   WG_ENABLE="false"
#   PROXMOX_STORAGE="local-lvm"
#   VM_BRIDGE="vmbr1"
#   VM_CORES="10"
#   VM_GW="192.168.12.1"
#   VM_IP6_STATIC="fd01:1:1:1::139"
#   VM_GW6="fd01:1:1:1::1"
#   PBS_STORAGE=""
#   DOMAIN_NAME="projekte-koenig.eu"        # -> DOMAIN="udp.projekte-koenig.eu"
