# .env.example — Vorlage fuer Pflicht-Umgebungsvariablen
# Kopieren nach .env.local, Werte eintragen, NIE committen.
# Vor Skriptaufruf: source .env.local
#
# Alle mit ? markierten Variablen sind mandatory.
# Das Skript bricht in 01_config.sh ab wenn sie fehlen.
#
# Dokumentation / Spec:
# https://doc.data-dna.eu/de/specs/civitas-core-plugin/serveraufbau-v1/

export CIVITAS_DEBUG="true"
export LE_CERT="false"
export NO_NEW_LE_CERT="false"
export CERT_BACKUP_FILE="le-certs-backup.yaml"
export APISIX_DASHBOARD="false"
export RUN_TESTS="true"
export DOMAIN="udp.example.eu"

# Für Tests
export TEST_ID="udp"
export BASE_DOMAIN="example.eu"

# Für RustFS
export RUSTFS_ENDPOINT="http://192.168.aaa.bbb:9000"
export RUSTFS_ACCESS_KEY=****
export RUSTFS_SECRET_KEY=****


# VM-Zugang
export ROOT_PASSWORD=****

# Domainname
export DOMAIN_NAME="example.eu"

# SMTP (netcup)
export SMTP_HOST="example.net"
export SMTP_PORT="587"
export SMTP_USER="no-reply@example.eu"
export SMTP_PASS=****

# CIVITAS/CORE Admin
export ADMIN_EMAIL="admin@example.eu"
export ADMIN_PASS=****
# export TENANT_ADMIN_PASS=****

# WireGuard
# OPN PubKey: grep PrivateKey /usr/local/etc/wireguard/wg0.conf | awk '{print $3}' | wg pubkey
export WG_VM_PRIVATE_KEY=****
export WG_OPN_PUBLIC_KEY=****
export WG_PRESHARED_KEY=****
export WG_OPN_ENDPOINT="aaa.bbb.ccc.ddd:51820"  # oeffentliche IP:Port der OPNsens/HAProxy

