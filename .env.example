# .env.example — Vorlage fuer Pflicht-Umgebungsvariablen
# Kopieren nach .env.local, Werte eintragen, NIE committen.
# Vor Skriptaufruf: source .env.local
#
# Alle mit ? markierten Variablen sind mandatory.
# Das Skript bricht in 01_config.sh ab wenn sie fehlen.

# VM-Zugang
export ROOT_PASSWORD=""          # ? root-Passwort der VM

# SMTP (netcup)
export SMTP_HOST="mx2fab.netcup.net"
export SMTP_PORT="587"
export SMTP_USER="no-reply@data-dna.eu"
export SMTP_PASS=""              # ? SMTP-Passwort aus netcup WCP

# CIVITAS/CORE Admin
export ADMIN_EMAIL="admin@data-dna.eu"
export ADMIN_PASS=""             # ? Keycloak Initial-Admin-Passwort

# WireGuard
export WG_VM_PRIVATE_KEY=""      # ? wg genkey (auf der VM)
export WG_OPN_PUBLIC_KEY=""      # ? wg pubkey < opnsense_private.key
export WG_PRESHARED_KEY=""       # optional: wg genpsk
export WG_OPN_ENDPOINT=""        # ? oeffentliche IP:Port der OPNsense
